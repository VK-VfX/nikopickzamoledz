<?xml version="1.0" encoding="utf-8"?>
<!-- The app only ever talks to GitHub, and only over HTTPS. Plain HTTP is refused outright. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
